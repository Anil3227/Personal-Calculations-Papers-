Cell[BoxData[
 RowBox[{"nsol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Eqx", "\[Equal]", 
          RowBox[{
           RowBox[{"x", "'"}], "[", "\[Eta]", "]"}]}], ",", 
         RowBox[{"Eqy", "\[Equal]", 
          RowBox[{
           RowBox[{"y", "'"}], "[", "\[Eta]", "]"}]}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "\[Equal]", "0.01"}]}], "}"}], "]"}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "\[Eta]", "]"}], ",", " ", 
      RowBox[{"y", "[", "\[Eta]", "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Eta]", ",", " ", "0", ",", " ", "100"}], "}"}], ",", 
    RowBox[{"MaxSteps", "\[Rule]", 
     RowBox[{"10", "^", "5"}]}], ",", 
    RowBox[{"StartingStepSize", "\[Rule]", "0.001"}], ",", 
    RowBox[{"MaxStepFraction", "\[Rule]", 
     RowBox[{"1", "/", "1000"}]}]}], "]"}]}]], "Input",
