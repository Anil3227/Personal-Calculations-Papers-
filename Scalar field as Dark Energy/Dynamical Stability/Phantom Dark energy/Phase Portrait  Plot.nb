Cell[BoxData[{
 RowBox[{
  RowBox[{"phantom", "=", 
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x", "^", "2"}]}], "+", 
        RowBox[{"y", "^", "2"}]}], "\[LessEqual]", "1"}], "&&", 
      RowBox[{"y", ">", "0"}], "&&", 
      RowBox[{"weff", "<", 
       RowBox[{"-", "1"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "2"}], "}"}], ",", 
     RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.45", ",", " ", "1", ",", " ", "0.4"}], "]"}]}], ",", 
     RowBox[{"BoundaryStyle", "\[Rule]", "None"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"Axes", "\[Rule]", "False"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"X", ",", "Y"}], "}"}]}], ",", 
     RowBox[{"FrameStyle", "\[Rule]", "30"}], ",", 
